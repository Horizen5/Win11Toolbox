<Window x:Class="Win11ToolboxSimple.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Win11 工具箱 · 简洁版" Height="660" Width="920"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        UseLayoutRounding="True">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom" Height="26">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="就绪" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <Button x:Name="ElevateButton" Content="以管理员身份重新启动"
                        Padding="10,0" Height="20" Visibility="Collapsed" Click="Elevate_Click" />
            </StatusBarItem>
        </StatusBar>

        <TabControl x:Name="Tabs" Margin="6">

            <!-- ==================== 设置 ==================== -->
            <TabItem Header="  设置  ">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="搜索" VerticalAlignment="Center" />
                        <TextBox x:Name="SearchBox" Width="180" Margin="6,0,0,0"
                                 VerticalContentAlignment="Center" TextChanged="Search_Changed" />
                        <TextBlock Text="分类" VerticalAlignment="Center" Margin="14,0,0,0" />
                        <ComboBox x:Name="CategoryCombo" Width="150" Margin="6,0,0,0"
                                  VerticalContentAlignment="Center" SelectionChanged="Filter_Changed" />
                        <Button Content="刷新状态" Margin="14,0,0,0" Padding="12,2" Click="Refresh_Click" />
                        <TextBlock x:Name="CountHint" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="#666" />
                    </StackPanel>

                    <!--
                        两列铺开，一屏 24 项（原来竖着一列只放得下 11 项）。
                        名字最长 27 个字（「关闭 SysMain 服务（原 Superfetch）」），
                        单格 420 宽够放；超了用省略号 + ToolTip 兜底。
                    -->
                    <ListBox x:Name="SettingList" BorderThickness="1"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Width" Value="420" />
                                <Setter Property="Margin" Value="2" />
                                <Setter Property="Padding" Value="6,4" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                              IsChecked="{Binding IsOn, Mode=TwoWay}" Click="Row_Click" />
                                    <StackPanel Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}" />
                                        <TextBlock Text="{Binding Desc}" Foreground="#666" FontSize="11"
                                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0"
                                                   ToolTip="{Binding Desc}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding StateText}" MinWidth="54"
                                               TextAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{Binding StateBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- ==================== 工具 ==================== -->
            <TabItem Header="  工具  ">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Foreground="#666"
                               Text="双击即可运行。共 47 个系统自带工具。" />
                    <!--
                        横排铺开，像控制面板的图标视图：一行四个，47 项一屏能看到三十来个。
                        原来是竖着一行一项、整宽排下去，一屏只放得下十一行，翻页翻得手酸。
                    -->
                    <ListBox x:Name="ToolList" BorderThickness="1" MouseDoubleClick="ToolList_DoubleClick"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Width" Value="208" />
                                <Setter Property="Margin" Value="2" />
                                <Setter Property="Padding" Value="8,6" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Description}" Foreground="#666" FontSize="11"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               MaxHeight="30" Margin="0,2,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- ==================== 入口 ==================== -->
            <TabItem Header="  入口  ">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Foreground="#666"
                               Text="双击一行即可打开。都是系统自带的设置页面和经典控制台项。" />
                    <ListBox x:Name="LinkList" BorderThickness="1" MouseDoubleClick="LinkList_DoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Margin="0,6" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
