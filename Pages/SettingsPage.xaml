<Page
    Style="{StaticResource DefaultPageStyle}"
    x:Class="Win11Toolbox.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:Win11Toolbox.Controls"
    Title="设置">

    <ScrollViewer Padding="24,18,24,36" VerticalScrollBarVisibility="Auto">
        <controls:SpacingStackPanel Spacing="14">

            <StackPanel>
                <ui:TextBlock FontTypography="Title" Text="设置" />
                <ui:TextBlock FontTypography="Body" Margin="0,4,0,0"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Text="个性化外观与应用信息" />
            </StackPanel>

            <ui:TextBlock FontTypography="BodyStrong" Text="个性化" Margin="2,6,0,0" />
            <ui:Card Padding="16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body" Text="深色模式" />
                            <ui:TextBlock FontTypography="Caption" Margin="0,2,0,0"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          Text="切换到 Windows 11 深色主题" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="DarkSwitch" HorizontalAlignment="Right"
                                         VerticalAlignment="Center" Checked="Dark_Toggled" Unchecked="Dark_Toggled" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" />
                    <Grid Margin="0,12,0,0">
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body" Text="跟随系统主题" />
                            <ui:TextBlock FontTypography="Caption" Margin="0,2,0,0"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          Text="随 Windows 的深浅色设置自动切换" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="FollowSwitch" HorizontalAlignment="Right"
                                         VerticalAlignment="Center" IsChecked="True"
                                         Checked="Follow_Toggled" Unchecked="Follow_Toggled" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <ui:TextBlock FontTypography="BodyStrong" Text="快捷键" Margin="2,6,0,0" />
            <ui:Card Padding="16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <ui:TextBlock FontTypography="Body" Text="F5" />
                        <ui:TextBlock FontTypography="Caption" HorizontalAlignment="Right"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Text="重新读取当前页面的数据" />
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <ui:TextBlock FontTypography="Body" Text="Ctrl + F" />
                        <ui:TextBlock FontTypography="Caption" HorizontalAlignment="Right"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Text="跳到当前页面的搜索框" />
                    </Grid>
                    <Grid>
                        <ui:TextBlock FontTypography="Body" Text="Ctrl + 1 ~ 9" />
                        <ui:TextBlock FontTypography="Caption" HorizontalAlignment="Right"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Text="按左侧导航顺序快速切页" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <ui:TextBlock FontTypography="BodyStrong" Text="关于本程序" Margin="2,6,0,0" />
            <ui:Card Padding="16">
                <StackPanel>
                    <ui:TextBlock x:Name="VersionText" FontTypography="Body" Text="Win11 工具箱" />
                    <ui:TextBlock FontTypography="Caption" Margin="0,4,0,0" TextWrapping="Wrap"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  Text="C# / .NET 10 + WPF + WPF-UI 实现，界面使用系统原生的 Win11 控件样式与 Mica 背景。" />
                    <ui:Button Margin="0,12,0,0" Content="打开配置目录" Icon="{ui:SymbolIcon Folder24}"
                               Appearance="Secondary" HorizontalAlignment="Left" Click="OpenConfig_Click" />
                </StackPanel>
            </ui:Card>

        </controls:SpacingStackPanel>
    </ScrollViewer>
</Page>
