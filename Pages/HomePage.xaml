<Page
    Style="{StaticResource DefaultPageStyle}"
    x:Class="Win11Toolbox.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:Win11Toolbox.Controls"
    Title="主页">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,18,24,36">
        <controls:SpacingStackPanel Spacing="14">

            <Grid>
                <StackPanel>
                    <ui:TextBlock FontTypography="Title" Text="主页" />
                    <ui:TextBlock FontTypography="Body" Margin="0,4,0,0"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  Text="设备状态、实时性能与常用入口" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ui:Button x:Name="RefreshButton" Content="刷新" Icon="{ui:SymbolIcon ArrowSync20}"
                               Appearance="Secondary" Margin="0,0,8,0" Click="Refresh_Click" />
                    <ui:Button Content="一键体检" Icon="{ui:SymbolIcon Heart20}" Appearance="Primary"
                               Click="Check_Click" />
                </StackPanel>
            </Grid>

            <!-- 设备卡：版式对齐「设置 → 系统」顶部那张 -->
            <ui:Card Padding="20">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 设备缩略图：黑色窄边框 + 系统自带的那张 bloom 壁纸 -->
                        <Border Grid.Column="0" Width="104" Height="70" CornerRadius="7"
                                Background="#1B1B1B" Padding="3" VerticalAlignment="Top">
                            <Grid>
                                <Border CornerRadius="4">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#E8F1FA" Offset="0" />
                                            <GradientStop Color="#B9D3EE" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border CornerRadius="4" ClipToBounds="True">
                                    <Image x:Name="HeroShot" Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                            <ui:TextBlock x:Name="HeroName" FontSize="20" FontWeight="SemiBold"
                                          TextTrimming="CharacterEllipsis" Text="正在读取设备信息…" />
                            <ui:TextBlock x:Name="HeroModel" Margin="0,3,0,0" FontSize="12"
                                          TextTrimming="CharacterEllipsis"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          Text="正在检测设备型号" />
                            <ui:HyperlinkButton x:Name="RenameLink" Content="重命名" Padding="0"
                                                Margin="0,6,0,0" FontSize="12" Click="Rename_Click" />
                        </StackPanel>
                    </Grid>

                    <!-- 规格：和系统设置一样是「小号灰标签 + 大一号的值」，两列 -->
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,14">
                            <ui:TextBlock FontSize="12" Text="处理器"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:TextBlock x:Name="HeroCpu" FontSize="14" Margin="0,3,0,0"
                                          TextTrimming="CharacterEllipsis" Text="—" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,14">
                            <ui:TextBlock FontSize="12" Text="内存"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:TextBlock x:Name="HeroMem" FontSize="14" Margin="0,3,0,0"
                                          TextTrimming="CharacterEllipsis" Text="—" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,0">
                            <ui:TextBlock FontSize="12" Text="显卡"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:TextBlock x:Name="HeroGpu" FontSize="14" Margin="0,3,0,0"
                                          TextTrimming="CharacterEllipsis" Text="—" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <ui:TextBlock FontSize="12" Text="系统版本"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:TextBlock x:Name="HeroOs" FontSize="14" Margin="0,3,0,0"
                                          TextTrimming="CharacterEllipsis" Text="Windows · 正在检测" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- 监控 -->
            <Grid x:Name="MetricsGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
            </Grid>

            <!-- 体检 -->
            <ui:TextBlock FontTypography="BodyStrong" Text="设备体检" Margin="2,6,0,0" />
            <ui:Card Padding="16">
                <StackPanel>
                    <Grid>
                        <ui:TextBlock FontTypography="BodyStrong" Text="检查项" />
                        <ui:TextBlock x:Name="CheckSummary" FontTypography="Caption" HorizontalAlignment="Right"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="尚未运行" />
                    </Grid>
                    <StackPanel x:Name="CheckList" Margin="0,6,0,0" />
                </StackPanel>
            </ui:Card>

            <!-- 快捷入口 -->
            <ui:TextBlock FontTypography="BodyStrong" Text="常用入口" Margin="2,6,0,0" />
            <ui:Card Padding="8">
                <UniformGrid x:Name="QuickGrid" Rows="2" Columns="4" />
            </ui:Card>

        </controls:SpacingStackPanel>
    </ScrollViewer>
</Page>
