<Page
    Style="{StaticResource DefaultPageStyle}"
    x:Class="Win11Toolbox.Pages.FanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:Win11Toolbox.Controls"
    Title="风扇控制">

    <ScrollViewer Padding="24,18,24,36" VerticalScrollBarVisibility="Auto">
        <controls:SpacingStackPanel Spacing="14">

            <Grid>
                <StackPanel>
                    <ui:TextBlock FontTypography="Title" Text="风扇控制" />
                    <ui:TextBlock FontTypography="Body" Margin="0,4,0,0"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  Text="实时查看转速与温度，手动调节或交回自动控制" />
                </StackPanel>
                <ui:Button x:Name="RefreshButton" Content="刷新" Appearance="Secondary"
                           HorizontalAlignment="Right" VerticalAlignment="Top" Click="Refresh_Click" />
            </Grid>

            <Grid>
                <ui:InfoBar x:Name="StatusBar" IsOpen="True" IsClosable="False"
                            Severity="Informational" Title="正在读取风扇…" />
                <!-- 叠在 InfoBar 右侧；SetStatus 里会按按钮宽度给 InfoBar 留出右边距，
                     否则长句子会绕到按钮底下被压住 -->
                <ui:Button x:Name="StatusAction" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Visibility="Collapsed" Margin="0,0,10,0" Click="StatusAction_Click" />
            </Grid>

            <ui:Card Padding="18">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Gauge24" FontSize="20" Margin="0,0,10,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                            <ui:TextBlock FontTypography="BodyStrong" Text="风扇曲线" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ui:ToggleSwitch x:Name="CurveToggle" Content="启用"
                                             VerticalAlignment="Center"
                                             Checked="CurveToggle_Changed" Unchecked="CurveToggle_Changed" />
                            <!-- 收起后风扇区能整体上移，多风扇的机器一屏就能看全 -->
                            <ui:Button x:Name="CurveFold" Appearance="Transparent" Margin="10,0,0,0"
                                       Padding="6" ToolTip="展开曲线" Click="CurveFold_Click">
                                <ui:SymbolIcon x:Name="CurveFoldIcon" Symbol="ChevronDown24" FontSize="14" />
                            </ui:Button>
                        </StackPanel>
                    </Grid>

                    <ui:TextBlock x:Name="CurveSummary" FontTypography="Caption" Margin="30,4,0,0"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  Text="按最高温度自动调节转速：低温静音，高温全速。" />

                    <!-- 默认收起：风扇多的时候，曲线一展开就把卡片全挤到屏幕外 -->
                    <StackPanel x:Name="CurveBody" Visibility="Collapsed">
                    <Border Margin="0,12,0,0" Height="164" CornerRadius="8"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <Canvas x:Name="CurveCanvas" ClipToBounds="True" SizeChanged="CurveCanvas_SizeChanged" />
                    </Border>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <ui:TextBlock x:Name="StartLabel" FontTypography="Caption"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          Text="起转温度 45 °C" />
                            <Slider x:Name="StartSlider" Minimum="30" Maximum="70" TickFrequency="1"
                                    IsSnapToTickEnabled="True" Value="45" Margin="0,2,0,0"
                                    ValueChanged="CurveValue_Changed" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <ui:TextBlock x:Name="FullLabel" FontTypography="Caption"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          Text="满载温度 80 °C" />
                            <Slider x:Name="FullSlider" Minimum="55" Maximum="95" TickFrequency="1"
                                    IsSnapToTickEnabled="True" Value="80" Margin="0,2,0,0"
                                    ValueChanged="CurveValue_Changed" />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <ui:TextBlock x:Name="MinLabel" FontTypography="Caption"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          Text="最低转速 30 %" />
                            <Slider x:Name="MinSlider" Minimum="0" Maximum="70" TickFrequency="5"
                                    IsSnapToTickEnabled="True" Value="30" Margin="0,2,0,0"
                                    ValueChanged="CurveValue_Changed" />
                        </StackPanel>
                    </Grid>
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- 预设按钮并到风扇标题行：原本独占一张卡片，白白吃掉一整行高度 -->
            <Grid Margin="2,6,0,0">
                <ui:TextBlock FontTypography="BodyStrong" Text="风扇" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ui:TextBlock FontTypography="Caption" Text="快捷预设" VerticalAlignment="Center"
                                  Margin="0,0,10,0"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:Button Content="静音" Appearance="Secondary" Padding="12,3,12,4" FontSize="12"
                               Margin="0,0,6,0" Click="PresetQuiet_Click" />
                    <ui:Button Content="均衡" Appearance="Secondary" Padding="12,3,12,4" FontSize="12"
                               Margin="0,0,6,0" Click="PresetBalanced_Click" />
                    <ui:Button Content="全速" Padding="12,3,12,4" FontSize="12"
                               Margin="0,0,6,0" Click="PresetMax_Click" />
                    <ui:Button Content="全部自动" Appearance="Secondary" Padding="12,3,12,4" FontSize="12"
                               Click="PresetAuto_Click" />
                </StackPanel>
            </Grid>

            <!-- 网格排列：每个风扇一张固定宽度的小卡，而不是一张占满整行的长条。
                 8 个风扇时纵向卡片要滚 8 屏，网格三列一屏就能看全。 -->
            <WrapPanel x:Name="FanPanel" />

            <ui:Card x:Name="EmptyCard" Padding="16" Visibility="Collapsed">
                <ui:TextBlock x:Name="EmptyText" FontTypography="Body" TextWrapping="Wrap"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Text="没有检测到风扇。" />
            </ui:Card>

            <ui:TextBlock FontTypography="BodyStrong" Text="温度" Margin="2,6,0,0" />
            <ui:Card Padding="14">
                <WrapPanel x:Name="TempPanel" />
            </ui:Card>

            <ui:TextBlock FontTypography="Caption" Margin="2,4,0,0" TextWrapping="Wrap"
                          Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                          Text="转速与调速依赖主板 SuperIO 芯片，需要管理员权限 + PawnIO 驱动。调速属于软件控制，退出程序或重启后由 BIOS 重新接管。" />

        </controls:SpacingStackPanel>
    </ScrollViewer>
</Page>
