<Page
    Style="{StaticResource DefaultPageStyle}"
    x:Class="Win11Toolbox.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:Win11Toolbox.Controls"
    Title="关于">

    <ScrollViewer Padding="24,18,24,36" VerticalScrollBarVisibility="Auto">
        <controls:SpacingStackPanel Spacing="14">

            <StackPanel>
                <ui:TextBlock FontTypography="Title" Text="关于" />
                <ui:TextBlock x:Name="VersionLine" FontTypography="Body" Margin="0,4,0,0"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Text="Win11 工具箱" />
            </StackPanel>

            <ui:Card Padding="20">
                <StackPanel>
                    <ui:TextBlock FontTypography="Subtitle" Text="Win11 工具箱" />
                    <ui:TextBlock FontTypography="Caption" Margin="0,2,0,0"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  Text="C# · .NET 10 · WPF · WPF-UI" />
                    <ui:TextBlock FontTypography="Body" Margin="0,10,0,0" TextWrapping="Wrap"
                                  Text="把常用的硬件检测、系统工具与维护脚本收进同一个界面。界面使用 Windows 11 的 Fluent 设计语言：Mica 云母背景、圆角卡片、左侧导航、系统强调色，字体为 Segoe UI Variable。" />
                </StackPanel>
            </ui:Card>

            <ui:TextBlock FontTypography="BodyStrong" Text="功能一览" Margin="2,6,0,0" />
            <ui:Card Padding="16">
                <StackPanel>
                    <ui:TextBlock FontTypography="Body" Text="硬件信息 · WMI 读取 CPU、内存逐条插槽、显卡、主板、硬盘与网络" TextWrapping="Wrap" />
                    <ui:TextBlock FontTypography="Body" Margin="0,6,0,0" Text="实时监控 · CPU / 内存 / 系统盘 / 网络速率的秒级折线" TextWrapping="Wrap" />
                    <ui:TextBlock FontTypography="Body" Margin="0,6,0,0" Text="系统工具 · 40+ 个 Windows 内置工具的分类启动器" TextWrapping="Wrap" />
                    <ui:TextBlock FontTypography="Body" Margin="0,6,0,0" Text="实用工具 · 哈希校验、编解码、密码生成、端口检测与 Ping" TextWrapping="Wrap" />
                    <ui:TextBlock FontTypography="Body" Margin="0,6,0,0" Text="系统优化 · 临时文件清理、DNS / 图标缓存修复、启动项与电源计划" TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <ui:TextBlock FontTypography="BodyStrong" Text="参考的项目与工具" Margin="2,6,0,0" />
            <ui:Card Padding="16">
                <StackPanel>
                    <ui:TextBlock FontTypography="Body" TextWrapping="Wrap"
                                  Text="「轻松设置」页的开关清单，参照 Windows 11 轻松设置 等系统调校工具整理；注册表读写、状态探测与界面均为本项目自行实现，未使用其代码。" />
                    <ui:TextBlock FontTypography="Caption" Margin="0,10,0,0" TextWrapping="Wrap"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  Text="界面与实现参考的开源项目：" />
                    <ui:HyperlinkButton Content="TubaWinUi3 — 用 WinUI 3 重写的图吧工具箱" Click="OpenTuba_Click" HorizontalAlignment="Left" Margin="0,4,0,0" />
                    <ui:HyperlinkButton Content="SYSTools — C# + WPF Modern 的系统工具箱" Click="OpenSys_Click" HorizontalAlignment="Left" Margin="0,4,0,0" />
                    <ui:HyperlinkButton Content="WPF-UI — 本项目的 Fluent 控件库" Click="OpenWpfUi_Click" HorizontalAlignment="Left" Margin="0,4,0,0" />
                </StackPanel>
            </ui:Card>

        </controls:SpacingStackPanel>
    </ScrollViewer>
</Page>
