<Page
    Style="{StaticResource DefaultPageStyle}"
    x:Class="Win11Toolbox.Pages.HardwarePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="硬件信息">

    <Grid Margin="24,18,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <ui:TextBlock FontTypography="Title" Text="硬件信息" />
            <ui:TextBlock FontTypography="Body" Margin="0,4,0,0"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="处理器、内存、显卡、主板与存储的详细参数" />
        </StackPanel>

        <TabControl Grid.Row="1" x:Name="Tabs" Style="{StaticResource Win11TabControl}">
            <TabItem Header="概览">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="OverviewPanel" Margin="0,10,0,16" />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="处理器">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="CpuPanel" Margin="0,10,0,16" />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="内存">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="MemoryPanel" Margin="0,10,0,16" />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="显卡">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="GpuPanel" Margin="0,10,0,16" />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="主板">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="BoardPanel" Margin="0,10,0,16" />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="存储">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DiskPanel" Margin="0,10,0,16" />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="网络">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="NetworkPanel" Margin="0,10,0,16" />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="其他">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="OtherPanel" Margin="0,10,0,16" />
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
