<Page
    Style="{StaticResource DefaultPageStyle}"
    x:Class="Win11Toolbox.Pages.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="系统工具">

    <Grid Margin="24,18,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <ui:TextBlock FontTypography="Title" Text="系统工具" />
            <ui:TextBlock x:Name="Subtitle" FontTypography="Body" Margin="0,4,0,0"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="集成了 Windows 常用工具" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,10">
            <ui:TextBox x:Name="SearchBox" Width="340" PlaceholderText="搜索工具，例如：设备、磁盘、网络"
                        TextChanged="Search_TextChanged" />
            <ui:TextBlock x:Name="CountHint" FontTypography="Caption" Margin="12,0,0,0"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,24">
                <StackPanel x:Name="Sections" />
                <ui:Card x:Name="EmptyHint" Padding="20" Visibility="Collapsed">
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="没有找到匹配的工具" />
                        <ui:TextBlock FontTypography="Caption" Margin="0,4,0,0"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Text="换个关键词试试，例如「磁盘」「网络」「设置」" />
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
